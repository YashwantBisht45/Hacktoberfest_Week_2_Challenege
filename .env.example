# ScopeGuard AI - Unified Monorepo Configuration Template

# =============================================================================
# BACKEND SERVICE (server/)
# =============================================================================
PORT=5000
# HOST: Omit in local development for dual-stack IPv4/IPv6; set HOST=0.0.0.0 on Render
# HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=30

# AI Provider: 'ollama' (local) or 'hosted' (OpenAI-compatible open-weight endpoint)
AI_PROVIDER=ollama
AI_TIMEOUT_MS=180000

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Hosted Open-Weight Gemma Configuration (when AI_PROVIDER=hosted)
# Option A: OpenRouter (Verified Active Default)
HOSTED_AI_BASE_URL=https://openrouter.ai/api/v1
HOSTED_AI_MODEL=google/gemma-2-9b-it
HOSTED_AI_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Option B: DeepInfra (Verified Alternative)
# HOSTED_AI_BASE_URL=https://api.deepinfra.com/v1/openai
# HOSTED_AI_MODEL=google/gemma-2-9b-it
# HOSTED_AI_API_KEY=your_deepinfra_api_key_here

# Note: Groq gemma2-9b-it was deprecated on Oct 8, 2025.

# =============================================================================
# FRONTEND SERVICE (client/)
# =============================================================================
# Set in production (e.g. Render Static Site). Leave blank in local development.
VITE_API_BASE_URL=
