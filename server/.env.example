# ScopeGuard AI Server Environment Configuration Template
# Copy this file to .env in local development: cp .env.example .env

# Server Binding
PORT=5000
# HOST: Omit in local development for automatic dual-stack IPv4/IPv6 (127.0.0.1 and ::1).
# In production on Render/containers: set HOST=0.0.0.0
# HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In development: http://localhost:5173,http://127.0.0.1:5173
# In production on Render: https://scopeguard-ui.onrender.com
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (max requests per 15-minute window for /api/analyze)
RATE_LIMIT_MAX=30

# =============================================================================
# AI PROVIDER SELECTION: 'ollama' (local) or 'hosted' (cloud open-weight endpoint)
# =============================================================================
AI_PROVIDER=ollama
AI_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# 1. Local Open-Weight Inference via Ollama (Default for Local Development)
# -----------------------------------------------------------------------------
# Gemma 2 models:
# - gemma2:2b (Compact: ~1.6 GB RAM, recommended for everyday laptops)
# - gemma2:9b (Medium: ~5.5 GB RAM/VRAM, deeper reasoning)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# -----------------------------------------------------------------------------
# 2. Hosted Open-Weight Endpoint (Required when AI_PROVIDER=hosted)
# -----------------------------------------------------------------------------
# Supported Open-Weight Gemma 2 Providers:
#
# Option A: OpenRouter (Verified Active Default)
# Model page: https://openrouter.ai/models/google/gemma-2-9b-it
HOSTED_AI_BASE_URL=https://openrouter.ai/api/v1
HOSTED_AI_MODEL=google/gemma-2-9b-it
HOSTED_AI_API_KEY=sk-or-v1-your_openrouter_api_key_here
#
# Option B: DeepInfra (Verified Alternative)
# Model page: https://deepinfra.com/google/gemma-2-9b-it
# HOSTED_AI_BASE_URL=https://api.deepinfra.com/v1/openai
# HOSTED_AI_MODEL=google/gemma-2-9b-it
# HOSTED_AI_API_KEY=your_deepinfra_api_key_here
#
# Deprecation Notice:
# - Groq gemma2-9b-it was deprecated and retired by Groq on Oct 8, 2025.
# - Together AI serverless google/gemma-2-9b-it was deprecated from serverless catalog.
