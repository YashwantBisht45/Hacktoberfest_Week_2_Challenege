# ScopeGuard AI - Client Environment Configuration
#
# In local development:
# Leave this blank so that requests use the relative /api path proxied by Vite to http://localhost:5000
VITE_API_BASE_URL=

# In production (e.g., Render Static Site):
# Set this to the public URL of your deployed ScopeGuard backend service.
# Example:
# VITE_API_BASE_URL=https://scopeguard-api.onrender.com
